{
  "name": "@flarebase/react",
  "version": "1.0.0",
  "description": "Official React and Next.js reactive hooks for FlareBase Backend-as-a-Service",
  "author": "H R Arya Ayyappa Halambi",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --external react"
  },
  "peerDependencies": {
    "@flarebase/client": "^1.0.0",
    "react": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "flarebase",
    "react",
    "nextjs",
    "hooks",
    "realtime",
    "baas",
    "sqlite",
    "firebase-alternative",
    "typescript"
  ]
}
