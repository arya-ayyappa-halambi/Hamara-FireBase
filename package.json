{
  "name": "aegisdb",
  "version": "0.1.0",
  "description": "AegisDB — Firebase-like Backend-as-a-Service platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --watch .env --ext ts --exec ts-node src/server.ts",
    "dev:interactive": "node scripts/serve.js",
    "serve": "node scripts/serve.js",
    "host": "node scripts/serve.js",
    "host:open": "node scripts/serve.js --open",
    "run": "node scripts/serve.js",
    "start": "node scripts/serve.js",
    "start:interactive": "node scripts/serve.js",
    "start:prod": "node dist/server.js",
    "setup": "node scripts/setup.js",
    "stop": "node scripts/stop.js",
    "kill": "node scripts/stop.js",
    "build": "tsc --project tsconfig.json",
    "clean": "rm -rf dist",
    "test": "ts-node tests/remote-ott-access.test.ts && ts-node tests/tunnel-manager.test.ts && ts-node tests/traffic-topology.test.ts",
    "reset-admin": "ts-node src/scripts/reset-admin.ts"
  },
  "keywords": [
    "baas",
    "backend",
    "auth",
    "typescript"
  ],
  "author": "AegisDB Contributors",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1108.0",
    "@ngrok/ngrok": "^1.7.0",
    "ajv": "^8.20.0",
    "argon2": "^0.45.1",
    "axios": "^1.19.0",
    "better-sqlite3": "11.8.1",
    "cors": "^2.8.5",
    "dockerode": "^5.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "express-rate-limit": "^8.6.1",
    "file-type": "^22.0.1",
    "google-auth-library": "^11.0.1",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "jimp": "^1.6.1",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^4.1.0",
    "localtunnel": "^2.0.2",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "otplib": "^11.0.1",
    "puppeteer": "^25.7.0",
    "tar": "^7.5.22",
    "tree-kill": "^1.2.2",
    "unzipper": "^0.12.5",
    "uuid": "^11.1.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/dockerode": "^4.0.1",
    "@types/express": "^4.17.21",
    "@types/hpp": "^0.2.7",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/localtunnel": "^2.0.4",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.14.9",
    "@types/nodemailer": "^8.0.1",
    "@types/unzipper": "^0.10.11",
    "@types/uuid": "^11.0.0",
    "@types/ws": "^8.18.1",
    "autocannon": "^8.0.0",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  },
  "directories": {
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aryaayyappa/Hamara-FireBase.git"
  },
  "type": "commonjs",
  "types": "./dist/server.d.ts",
  "bugs": {
    "url": "https://github.com/aryaayyappa/Hamara-FireBase/issues"
  },
  "homepage": "https://github.com/aryaayyappa/Hamara-FireBase#readme"
}
