{
  "name": "aegisdb",
  "version": "0.1.0",
  "description": "AegisDB — Firebase-like Backend-as-a-Service platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --watch .env --ext ts --exec ts-node src/server.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/server.js",
    "clean": "rm -rf dist",
    "reset-admin": "ts-node src/scripts/reset-admin.ts"
  },
  "keywords": [
    "baas",
    "backend",
    "auth",
    "typescript"
  ],
  "author": "AegisDB Contributors",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1108.0",
    "ajv": "^8.20.0",
    "argon2": "^0.45.1",
    "axios": "^1.19.0",
    "better-sqlite3": "^13.0.2",
    "cors": "^2.8.5",
    "dockerode": "^5.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.1",
    "file-type": "^22.0.1",
    "google-auth-library": "^11.0.1",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "jimp": "^1.6.1",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^4.1.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "otplib": "^11.0.1",
    "tar": "^7.5.22",
    "tree-kill": "^1.2.2",
    "unzipper": "^0.12.5",
    "uuid": "^11.1.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/dockerode": "^4.0.1",
    "@types/express": "^4.17.21",
    "@types/hpp": "^0.2.7",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.14.9",
    "@types/nodemailer": "^8.0.1",
    "@types/unzipper": "^0.10.11",
    "@types/uuid": "^11.0.0",
    "@types/ws": "^8.18.1",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
