# ─────────────────────────────────────────────
#  FlareBase — Environment Configuration Template
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development

# JWT
# Generate a strong secret: `openssl rand -hex 64`
JWT_SECRET=replace_this_with_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=7d

# CORS — comma-separated list of allowed origins (use * for dev only)
CORS_ORIGIN=*

# Security & Recovery
RECOVERY_PIN=123456
ENCRYPTION_KEY=replace_this_with_a_long_random_secret_at_least_32_chars
EMAIL_HASH_PEPPER=replace_this_with_a_long_random_secret_at_least_32_chars

# SMTP (For Password Recovery Emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="FlareBase" <your_email@gmail.com>
FRONTEND_URL=http://localhost:3000

# ── OAuth 2.0 & Social Authentication Providers ───────────────────────────────
# Google OAuth (Console: https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# GitHub OAuth (Settings: https://github.com/settings/developers)
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Apple Sign-In
APPLE_CLIENT_ID=your_apple_service_id_here
APPLE_CLIENT_SECRET=your_apple_client_secret_here

# ── Perimeter Network Security & Super Admin Subnets ──────────────────────────
ADMIN_ALLOWED_SUBNET=127.0.0.1,192.168.0.0/16,10.0.0.0/8

